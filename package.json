{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx server.ts",
    "prebuild": "prisma generate",
    "build": "node scripts/build-production.mjs",
    "start": "tsx server.ts",
    "pretest": "prisma generate",
    "test": "vitest run",
    "prelint": "prisma generate",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:setup": "tsx scripts/setup-db-env.ts",
    "db:setup:check": "tsx scripts/setup-db-env.ts --check",
    "db:repair:check": "tsx scripts/repair-db-env.ts --check",
    "db:repair:local": "tsx scripts/repair-db-env.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:target": "tsx scripts/migrate-target-db.ts",
    "db:verify:staging": "tsx scripts/verify-staging-db.ts",
    "db:sync:dev-credentials": "tsx scripts/sync-dev-credentials.ts",
    "db:clean-reset": "tsx scripts/clean-reset-db.ts",
    "db:clean-reset:dry-run": "tsx scripts/clean-reset-db.ts",
    "maintenance:backfill-bank-accounts": "tsx scripts/backfill-bank-accounts.ts",
    "maintenance:key-inventory": "tsx scripts/backfill-bank-accounts.ts --inventory",
    "test:integration": "node scripts/run-integration-tests.mjs tests/integration",
    "test:integration:concurrency": "node scripts/run-integration-tests.mjs tests/integration/concurrent-bank-account-default.test.ts",
    "test:integration:key-rotation": "node scripts/run-integration-tests.mjs tests/integration/key-rotation-reencryption.test.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kannada": "^5.3.0",
