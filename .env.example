# ==============================================================================
# CoreERP Environment Configuration Template (.env.example)
# Note: Use placeholder values only. Never commit real credentials or keys.
# ==============================================================================

# Server configuration
PORT=3000
NODE_ENV=development

# ==============================================================================
# PostgreSQL Five-Environment Database Separation
# ==============================================================================
# Run `npm run db:setup` on a fresh installation to safely initialize local
# git-ignored environment files (.env, .env.staging, .env.integration-test)
# with consistent, unique credentials and zero risk to existing files/volumes.
#
#   1. Development:      localhost:5432 / core_erp                  (docker-compose.dev.yml -> postgres)
#   2. Automated Test:   localhost:5433 / core_erp_test             (docker-compose.dev.yml -> postgres-test)
#   3. Integration Test: localhost:5434 / core_erp_integration_test (docker-compose.integration-test.yml)
#   4. Staging Verify:   localhost:5435 / core_erp_staging          (docker-compose.staging.yml)
#   5. Prisma Shadow:    localhost:5436 / core_erp_shadow           (docker-compose.dev.yml --profile shadow)
#
# NEVER share credentials, databases, or Docker volumes across environments.
# NEVER silently fall back from one database URL to another.
# ==============================================================================

# 1. Primary Development / Application Database (Port 5432 -> core_erp)
# Format: postgresql://<username>:<url_encoded_password>@<host>:<port>/<database>?schema=public
# In local development with docker-compose.dev.yml, default credentials are:
#   POSTGRES_USER=erp_user
#   POSTGRES_PASSWORD=erp_password_dev
#   POSTGRES_DB=core_erp
# In production, replace with unique, 64-character hex credentials (openssl rand -hex 32).
POSTGRES_USER="erp_user"
POSTGRES_PASSWORD="replace_with_strong_password"
POSTGRES_DB="core_erp"
DATABASE_URL="postgresql://erp_user:replace_with_strong_password@localhost:5432/core_erp?schema=public"

# 2. Automated Unit/Local Test Database (Port 5433 -> core_erp_test)
# Managed by docker-compose.dev.yml (`postgres-test`) and tests/setup.ts.
# Never use core_erp_test for staging verification or development.

# 3. Concurrency Integration Test Database (Port 5434 -> core_erp_integration_test)
# Dedicated PostgreSQL 16 integration tests run strictly on localhost:5434.
# The container password is stored in the local git-ignored .env.integration-test file
# (generated automatically by `npm run db:setup`).
# This variable is NOT given a default runtime value here and must NEVER contain real secrets:
#   TEST_DATABASE_URL="postgresql://erp_integration_user:<POSTGRES_PASSWORD_FROM_ENV_INTEGRATION_TEST>@localhost:5434/core_erp_integration_test?schema=public"

# 4. Isolated Staging Verification Database (Port 5435 -> core_erp_staging)
# Dedicated PostgreSQL 16 service defined in docker-compose.staging.yml (`postgres-staging`).
# Staging credentials are generated and stored in the git-ignored .env.staging file by `npm run db:setup`.
# STAGING_DATABASE_URL must point EXCLUSIVELY to core_erp_staging (never core_erp or core_erp_test).
#   STAGING_DATABASE_URL="postgresql://erp_staging_user:<STAGING_POSTGRES_PASSWORD_FROM_ENV_STAGING>@localhost:5435/core_erp_staging?schema=public"

# 5. Dedicated Prisma Shadow Database (Port 5436 -> core_erp_shadow)
# Optional: used only when authoring new migrations via `prisma migrate dev` with
# `docker compose -f docker-compose.dev.yml --profile shadow up -d postgres-shadow`.
#   SHADOW_POSTGRES_USER="erp_shadow_user"
#   SHADOW_POSTGRES_PASSWORD="<GENERATED_BY_DB_SETUP>"
#   SHADOW_POSTGRES_DB="core_erp_shadow"
#   SHADOW_DATABASE_URL="postgresql://erp_shadow_user:<SHADOW_POSTGRES_PASSWORD>@localhost:5436/core_erp_shadow?schema=public"

# Initial Super Admin Bootstrap (Optional; alternatively setup via web wizard)
# If provided, enables deterministic headless bootstrapping during initial deployment
BOOTSTRAP_SUPER_ADMIN_EMAIL="superadmin@yourcompany.com"
BOOTSTRAP_SUPER_ADMIN_PASSWORD="ReplaceWithComplexPassword123!"
BOOTSTRAP_COMPANY_NAME="Acme Industrial Enterprise"
BOOTSTRAP_COMPANY_CODE="ACME"

# Security & Secrets
# ==============================================================================
# In production (NODE_ENV=production), SESSION_SECRET is strictly required and must
# be a unique, cryptographically random string of at least 32 characters (64+ recommended).
# Generate securely in shell via:
#   openssl rand -hex 32
# or Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: Do NOT use placeholder strings, default keys, or commit real secrets to git.
# The application will refuse to start in production if this variable is missing or weak.
SESSION_SECRET="replace_with_64_character_cryptographically_secure_random_string"
BIOMETRIC_BRIDGE_TOKEN="replace_with_lan_bridge_authentication_secret_token"

# Dedicated 256-bit AES-GCM encryption key for corporate bank credentials (Phase 2.3)
# Strictly required in production (64-character hexadecimal string representing 32 bytes).
# Generate via: openssl rand -hex 32
BANK_ENCRYPTION_KEY="replace_with_64_character_hex_bank_encryption_key_256_bit"

# Active Key Identifier (default: "k1"). Embedded in ciphertext envelopes: enc:v1:<keyId>:<payload>
BANK_ACTIVE_KEY_ID="k1"

# Historical Key Ring for non-breaking key rotation (JSON object mapping keyId -> 64-hex key).
# Used to decrypt existing records encrypted under older keys during rotation.
# Example: '{"k0":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'
BANK_HISTORICAL_KEYS='{}'

# ==============================================================================
# SAFE KEY ROTATION & RE-ENCRYPTION OPERATIONAL PROCEDURE (Phase 2.3)
# ==============================================================================
# 1. Generate new 256-bit key: openssl rand -hex 32
# 2. Add current active key to BANK_HISTORICAL_KEYS:
#      BANK_HISTORICAL_KEYS='{"k1":"<current_active_key_material>"}'
# 3. Configure the new key as active:
#      BANK_ENCRYPTION_KEY="<new_key_material>"
#      BANK_ACTIVE_KEY_ID="k2"
# 4. Deploy changes. Existing rows decrypt via historical key; new writes use k2.
# 5. Inspect key distribution using read-only inventory:
#      npm run maintenance:key-inventory
# 6. Execute dry-run re-encryption to verify candidates without writing:
#      npm run maintenance:backfill-bank-accounts -- --dry-run --mode rotation-only
# 7. When explicitly authorized, run confirmed re-encryption to migrate historical records:
#      npm run maintenance:backfill-bank-accounts -- --confirm --mode rotation-only
# 8. Re-run key inventory (Step 5) to verify 0 records remain under historical key k1.
#    Only when confirmed 0 across all database instances and backups may k1 be retired.
# ==============================================================================

# AI Studio runtime variables (automatically managed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
