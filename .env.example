# ==============================================================================
# CoreERP Environment Configuration Template (.env.example)
# Note: Use placeholder values only. Never commit real credentials or keys.
# ==============================================================================

# Server configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://erp_user:replace_with_strong_password@localhost:5432/core_erp?schema=public"

# Standard Unit Test & Staging Database Configuration (Port 5433 from docker-compose.dev.yml)
# WARNING: Must point to an isolated, disposable database containing "_test" or "_staging" in the name.
STAGING_DATABASE_URL="postgresql://erp_test_user:replace_with_test_password@localhost:5433/core_erp_test?schema=public"

# Concurrency Integration Test Database Configuration (Port 5434 from docker-compose.integration-test.yml)
# DOCUMENTATION ONLY: Dedicated PostgreSQL 16 concurrency integration tests run on localhost:5434.
# The container password is read strictly from the local, git-ignored .env.integration-test file.
# This variable is NOT given a default runtime value here and must NEVER contain real or usable credentials.
# To run integration tests locally, construct your connection string with the password from .env.integration-test:
#   TEST_DATABASE_URL="postgresql://erp_integration_user:<POSTGRES_PASSWORD_FROM_ENV_INTEGRATION_TEST>@localhost:5434/core_erp_integration_test?schema=public"

# Initial Super Admin Bootstrap (Optional; alternatively setup via web wizard)
# If provided, enables deterministic headless bootstrapping during initial deployment
BOOTSTRAP_SUPER_ADMIN_EMAIL="superadmin@yourcompany.com"
BOOTSTRAP_SUPER_ADMIN_PASSWORD="ReplaceWithComplexPassword123!"
BOOTSTRAP_COMPANY_NAME="Acme Industrial Enterprise"
BOOTSTRAP_COMPANY_CODE="ACME"

# Security & Secrets
# ==============================================================================
# In production (NODE_ENV=production), SESSION_SECRET is strictly required and must
# be a unique, cryptographically random string of at least 32 characters (64+ recommended).
# Generate securely in shell via:
#   openssl rand -hex 32
# or Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: Do NOT use placeholder strings, default keys, or commit real secrets to git.
# The application will refuse to start in production if this variable is missing or weak.
SESSION_SECRET="replace_with_64_character_cryptographically_secure_random_string"
BIOMETRIC_BRIDGE_TOKEN="replace_with_lan_bridge_authentication_secret_token"

# Dedicated 256-bit AES-GCM encryption key for corporate bank credentials (Phase 2.3)
# Strictly required in production (64-character hexadecimal string representing 32 bytes).
# Generate via: openssl rand -hex 32
BANK_ENCRYPTION_KEY="replace_with_64_character_hex_bank_encryption_key_256_bit"

# Active Key Identifier (default: "k1"). Embedded in ciphertext envelopes: enc:v1:<keyId>:<payload>
BANK_ACTIVE_KEY_ID="k1"

# Historical Key Ring for non-breaking key rotation (JSON object mapping keyId -> 64-hex key).
# Used to decrypt existing records encrypted under older keys during rotation.
# Example: '{"k0":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'
BANK_HISTORICAL_KEYS='{}'

# ==============================================================================
# SAFE KEY ROTATION & RE-ENCRYPTION OPERATIONAL PROCEDURE (Phase 2.3)
# ==============================================================================
# 1. Generate new 256-bit key: openssl rand -hex 32
# 2. Add current active key to BANK_HISTORICAL_KEYS:
#      BANK_HISTORICAL_KEYS='{"k1":"<current_active_key_material>"}'
# 3. Configure the new key as active:
#      BANK_ENCRYPTION_KEY="<new_key_material>"
#      BANK_ACTIVE_KEY_ID="k2"
# 4. Deploy changes. Existing rows decrypt via historical key; new writes use k2.
# 5. Inspect key distribution using read-only inventory:
#      npm run maintenance:key-inventory
# 6. Execute dry-run re-encryption to verify candidates without writing:
#      npm run maintenance:backfill-bank-accounts -- --dry-run --mode rotation-only
# 7. When explicitly authorized, run confirmed re-encryption to migrate historical records:
#      npm run maintenance:backfill-bank-accounts -- --confirm --mode rotation-only
# 8. Re-run key inventory (Step 5) to verify 0 records remain under historical key k1.
#    Only when confirmed 0 across all database instances and backups may k1 be retired.
# ==============================================================================

# AI Studio runtime variables (automatically managed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
