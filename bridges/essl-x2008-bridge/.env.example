# CoreERP eSSL X2008 LAN Bridge Environment Configuration
# Copy to .env on the Windows LAN Bridge host (192.168.1.16)
# NEVER commit real API keys into version control. Prefer Windows DPAPI via scripts/protect-credentials.ps1.

COREERP_BASE_URL=https://your-coreerp-domain.example.com
BRIDGE_ALLOW_INSECURE_HTTP=false

# Localhost-only health/status diagnostics endpoint
BRIDGE_HEALTH_HOST=127.0.0.1
BRIDGE_HEALTH_PORT=4379

# Continuous daemon polling intervals (milliseconds)
BRIDGE_HEARTBEAT_INTERVAL_MS=30000
BRIDGE_JOB_POLL_INTERVAL_MS=5000
BRIDGE_USER_SYNC_TIMEOUT_MS=45000

# Optional single-terminal override (if not using bridge.config.json)
# DEVICE_SERIAL_NUMBER=NFZ8252800275
# DEVICE_IP=192.168.1.201
# DEVICE_PORT=4370
# DEVICE_COMM_KEY=0
# DEVICE_TIMEZONE=Asia/Kolkata
# COREERP_DEVICE_API_KEY=bio_live_replace_with_one_time_key
